# 正式部署的 web 容器:第一階段用 Node 建置 Vue 前端,
# 第二階段用 Caddy 服務靜態檔並反向代理 /api 至後端(維持 5 容器架構,不另開 Node 容器)。
#
# --platform=$BUILDPLATFORM 是必要的:前端產出是靜態 HTML/JS/CSS,與 CPU 架構無關,
# 沒有理由為每個目標架構各編譯一次。不加這行,建雙架構映像時 arm64 那份會在
# QEMU 模擬下跑 npm 與 vite——v1.2.0 首次發版就是這樣跑了 6 小時、
# 撞上 GitHub Actions 的上限被取消,api/worker 都推上去了只有 web 沒推成。
FROM --platform=$BUILDPLATFORM node:22-alpine AS build
WORKDIR /app
# 連同 lock 檔一起複製並改用 npm ci:正式映像的相依必須與 CI 驗證過的完全一致。
# 先前只複製 package.json 再 npm install,等於每次建置都可能裝到不同的版本。
COPY frontend/package.json frontend/package-lock.json ./
# 替代套件(v1.7.0):package.json 以 file: 引用,npm ci 之前就要在
COPY frontend/stubs ./stubs
RUN npm ci
COPY frontend/ ./
RUN npm run build

FROM caddy:2-alpine
# 不以 root 執行(v1.5.0 起;v1.7.0 改用 USER 指令,容器一啟動就是 caddy 使用者,
# 不再需要 su-exec)。憑證資料夾在映像裡就屬於 caddy,新建的 volume 會沿用這個擁有者;
# v1.4 以前 root 寫入的舊 volume 由 v1.5.0~v1.6.x 啟動時修正過,所以舊版要先升到 v1.6.1。
RUN addgroup -S -g 10001 caddy \
    && adduser -S -D -H -u 10001 -G caddy -h /data caddy \
    && mkdir -p /data /config \
    && chown -R caddy:caddy /data /config
COPY Caddyfile /etc/caddy/Caddyfile
COPY --from=build /app/dist /srv
COPY web-entrypoint.sh /usr/local/bin/web-entrypoint.sh
RUN chmod 755 /usr/local/bin/web-entrypoint.sh
USER caddy
ENTRYPOINT ["/usr/local/bin/web-entrypoint.sh"]
CMD ["caddy", "run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]
