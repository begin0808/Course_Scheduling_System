# 複製此檔為 .env,至少設定「管理員密碼」「校名」「資料庫密碼」三項即可啟動。
# (用 install.sh / install.ps1 安裝的話,安裝程式會自動填好,不必手動改。)
#   cp .env.example .env

# ── 必改 ─────────────────────────────
# 系統管理員預設帳密(首次登入後會強制改密碼)
# ⚠️ 只在系統「第一次啟動」時用來建立帳號,之後再改這裡不會生效。
#    密碼請只用英文與數字:$ 會被 docker compose 當成變數截掉,# 前有空白會被當成註解。
#    登不進去時:docker compose exec api python -m app.scripts.reset_admin
#    不設定的話,第一次啟動會自動產生一組臨時密碼,用 docker compose logs api 查看。
ADMIN_USERNAME=admin
# ADMIN_PASSWORD=
# 學校名稱(顯示於介面與匯出課表)。這只是「初始值」——系統啟用後可於
# 「系統管理 → 學校資訊」隨時修改,不需要回來改這裡再重啟。
SCHOOL_NAME=示範學校
# 學校所在時區(用於「今日課表」「當日調代課」等判定)
TZ=Asia/Taipei
# session cookie 簽章金鑰(正式部署務必改成隨機長字串,例如 openssl rand -hex 32 的輸出)
SECRET_KEY=please-change-this-to-a-random-secret

# ── 網路 ─────────────────────────────
# 對外連接埠(預設 80;若被占用可改 8080 等)
HTTP_PORT=80

# ── 選配:網域與 HTTPS(校外連線時使用,見 docs/deploy/https.md)──
# 內網 IP 使用維持預設(不設 SITE_ADDRESS,走 HTTP)即可。
# 若有公開網域並要自動申請 HTTPS 憑證,設為你的網域名(需先把網域 A 記錄指向本主機):
# SITE_ADDRESS=school.example.edu.tw
# HTTPS_PORT=443
# 設了上面的網域(走 HTTPS)後,系統會自動為登入 cookie 加上 Secure 旗標;
# 一般不必手動設定。若需強制指定可用下行(true=僅 HTTPS 傳送 cookie):
# COOKIE_SECURE=true

# ── 預建映像版本(僅「拉取映像」部署方式需要)──────────
# 用 docker compose pull 拉官方映像時,決定要拉哪一版。
# 預設 latest(最新);正式部署建議釘選版本號以利可控升級,例如:
# IMAGE_TAG=v1.6.1
# 若你是從原始碼 docker compose up -d 自行建置,此項可忽略。
IMAGE_TAG=latest

# ── 新版本提醒(v1.2.3 起)──────────────────────────
# 系統管理員會在「系統管理」看到是否有新版本。每天最多向 GitHub 讀取一次公開的版本資訊,
# 不送出任何學校資料;不希望主機連外時取消下行註解。
# UPDATE_CHECK_ENABLED=false

# ── 資料庫 ───────────────────────────
# 資料庫密碼請改成一組隨機的英數字(例如 openssl rand -hex 32 的輸出)。
# ⚠️ 只能在系統「第一次啟動」前設定:資料庫建好後再改這裡,系統會連不上資料庫。
# 系統會用這三項組出資料庫連線,不必另外設定 DATABASE_URL
# (v1.4 以前安裝的 .env 裡若有 DATABASE_URL,照舊優先使用)。
POSTGRES_USER=scheduler
POSTGRES_PASSWORD=please-change-this-db-password
POSTGRES_DB=scheduler

# ── 佇列 ─────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── 選填:互動式 API 文件 ──────────────
# 預設關閉。端點本身都有權限守著,公開它不是漏洞,但會把整套內部 API 攤在網路上;
# 若要自行串接系統 API,可暫時打開 http://<主機>/api/docs 查閱後再關掉。
# API_DOCS_ENABLED=true

# ── 選填:寄信(未設定則僅站內通知,見 M4-3)──
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
